{
  "name": "@jitl/primjs-emscripten",
  "version": "0.31.0",
  "license": "MIT",
  "description": "Direct PrimJS/LEPUS API bindings for WebAssembly. Native performance without QuickJS compatibility layer.",
  "repository": {
    "type": "git",
    "url": "https://github.com/justjake/quickjs-emscripten"
  },
  "author": {
    "name": "Jake Teton-Landis",
    "url": "https://jake.tl"
  },
  "scripts": {
    "check": "npx tsc --project . --noEmit",
    "build": "npx tsup",
    "clean": "git clean -fx dist"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "@jitl/tsconfig": "workspace:*"
  }
}
